      <aliases enabled='yes' />
      <column caption='Service Dimension' datatype='string' name='[Calculation_1161104386699264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [seat_comfort]&gt;0 THEN &quot;Seat Comfort&quot;&#13;&#10;    ELSEIF  [cabin_staff_service]&gt;0 THEN &quot;Cabin Staff Service&quot;&#13;&#10;    ELSEIF [food_beverages]&gt;0 THEN &quot;Food and Beverages&quot;&#13;&#10;    ELSEIF [ground_service]&gt;0 THEN &quot;Ground Service&quot;&#13;&#10;    ELSEIF [value_for_money]&gt;0 THEN &quot;Value for Money&quot;&#13;&#10;    ELSEIF [entertainment]&gt;0 THEN &quot;Entertainment&quot;&#13;&#10;    ELSE &quot;Overall Rating&quot;&#13;&#10;END' />
      </column>
      <column caption='traveller_type_clean' datatype='string' name='[Calculation_2092939991789568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([traveller_type]) &#13;&#10;    THEN &apos;Unknown&apos; &#13;&#10;ELSE [traveller_type] &#13;&#10;END' />
      </column>
      <column caption='ISO_CODE_Clean' datatype='string' name='[Calculation_2092939997122561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([Code])&#13;&#10;THEN &quot;CRQ&quot;&#13;&#10;ELSE [Code]&#13;&#10;END' />
      </column>
      <column caption='valid_review' datatype='boolean' name='[Calculation_2092940008136706]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// TRUE if rating is 1–10 and all service metrics are 1–5&#13;&#10;IF &#13;&#10;    [rating]              &gt;= 1 AND [rating]              &lt;= 10 AND&#13;&#10;    [seat_comfort]        &gt;= 1 AND [seat_comfort]        &lt;= 5  AND&#13;&#10;    [cabin_staff_service] &gt;= 1 AND [cabin_staff_service] &lt;= 5  AND&#13;&#10;    [food_beverages]      &gt;= 1 AND [food_beverages]      &lt;= 5  AND&#13;&#10;    [ground_service]      &gt;= 1 AND [ground_service]      &lt;= 5  AND&#13;&#10;    [value_for_money]     &gt;= 1 AND [value_for_money]     &lt;= 5  AND&#13;&#10;    [entertainment]       &gt;= 1 AND [entertainment]       &lt;= 5&#13;&#10;THEN &#13;&#10;    TRUE&#13;&#10;ELSE &#13;&#10;    FALSE&#13;&#10;END' />
      </column>
      <column caption='Review_Year' datatype='integer' name='[Calculation_2092940013621251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;year&apos;,[date])' />
      </column>
      <column caption='Review_Month' datatype='datetime' name='[Calculation_2092940014563332]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[date])' />
      </column>
      <column caption='Flight_Year' datatype='integer' name='[Calculation_2092940014731269]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;year&apos;,[date_flown])' />
      </column>
      <column caption='Recommended_Flag' datatype='integer' name='[Calculation_2092940017598470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOWER([recommended])=&apos;yes&apos; &#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Service_Index' datatype='real' name='[Calculation_2092940018085895]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([seat_comfort] + [cabin_staff_service]+[food_beverages]+[ground_service]+[value_for_money]+[entertainment])/6' />
